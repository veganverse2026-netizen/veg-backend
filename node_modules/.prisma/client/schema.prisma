generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  FAT_LOSS
  MUSCLE_BUILD
  LIFESTYLE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  ATHLETE
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

enum RecipeCategory {
  FAT_LOSS
  MUSCLE_BUILD
  LIFESTYLE
}

enum WorkoutType {
  HOME
  GYM
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum PostType {
  QUESTION
  WIN
  MEAL_IDEA
  NEED_SUPPORT
}

enum UserRole {
  MEMBER
  GYM_TRAINER
  ADMIN
}

enum UnitPreference {
  METRIC
  IMPERIAL
}

enum PlanChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id                       String         @id @default(cuid())
  name                     String?
  email                    String?        @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?
  heightCm                 Float?
  weightKg                 Float?
  bodyFatPercent           Float?
  age                      Int?
  gender                   Gender?
  activityLevel            ActivityLevel?
  goal                     Goal?
  dietaryStyle             String?
  dietaryPreferences       String[]       @default([])
  calorieTargetOverride    Int?
  proteinTargetOverride    Int?
  hydrationTargetOverride  Float?
  carbsTargetOverride      Int?
  fatTargetOverride        Int?
  goalTargetWeightKg       Float?
  goalStartWeightKg        Float?
  goalTargetBodyFatPercent Float?
  weeklyWorkoutTarget      Int?
  goalTimelineWeeks        Int?
  goalTargetDate           DateTime?
  goalSetAt                DateTime?
  goalLocked               Boolean        @default(false)
  // Adaptive nutrition targets — recalculated at most weekly from actual
  // logged weight trend vs. the goal's planned pace (MacroFactor-style).
  // Deliberately separate from calorieTargetOverride/etc: an explicit user
  // override always wins over this (see meal-logs.service.ts's precedence
  // chain), so a user who's manually set their own number is never silently
  // second-guessed by the algorithm.
  adaptiveCalorieTarget    Int?
  adaptiveProteinTarget    Int?
  adaptiveCarbsTarget      Int?
  adaptiveFatTarget        Int?
  adaptiveTargetNote       String?
  adaptiveTargetUpdatedAt  DateTime?
  onboardingDone           Boolean        @default(false)
  onboardingCompletedAt    DateTime?
  streakCount              Int            @default(0)
  streakFreezesAvailable   Int            @default(2)
  streakFreezesResetAt     DateTime?
  mealPlanJson             String?        @db.Text
  unitPreference           UnitPreference @default(METRIC)
  language                 String         @default("en")
  notificationPrefs        Json?
  expoPushToken            String?
  role                     UserRole       @default(MEMBER)
  gymTrainerId             String?
  approvedGymPlanJson      String?        @db.Text
  referralCode             String         @unique
  referredById             String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  accounts               Account[]
  sessions               Session[]
  trackers               Tracker[]
  workoutLogs            WorkoutLog[]
  workoutCompletions     WorkoutCompletion[]
  strengthGoals          StrengthGoal[]
  streaks                Streak[]
  cheatMeals             CheatMeal[]
  posts                  Post[]
  comments               Comment[]
  savedRecipes           SavedRecipe[]
  likes                  PostLike[]
  postBookmarks          PostBookmark[]
  postDrafts             PostDraft[]
  mealLogs               MealLog[]
  mealPlanRequests       MealPlanChangeRequest[]    @relation("MemberMealRequests")
  favoriteMeals          FavoriteMeal[]
  commentLikes           CommentLike[]
  challengesCreated      Challenge[]
  challengeParticipation ChallengeParticipant[]
  challengeCheckIns      ChallengeCheckIn[]
  following              Follow[]                   @relation("Following")
  followers              Follow[]                   @relation("Followers")
  dmConversationsA       Conversation[]             @relation("ConversationUserA")
  dmConversationsB       Conversation[]             @relation("ConversationUserB")
  dmMessages             Message[]
  dmReads                ConversationRead[]
  gymTrainer             GymTrainer?                @relation("AssignedTrainer", fields: [gymTrainerId], references: [id], onDelete: SetNull)
  trainerProfile         GymTrainer?                @relation("TrainerLinkedAccount")
  workoutPlanRequests    WorkoutPlanChangeRequest[] @relation("MemberPlanRequests")
  reviewedPlanRequests   WorkoutPlanChangeRequest[] @relation("PlanReviewedBy")
  gymProgressPhotos      GymProgressPhoto[]
  missedWorkoutReports   MissedWorkoutReport[]
  orders                 Order[]
  addresses              Address[]
  reviews                Review[]
  notifications          Notification[]
  reportsMade            Report[]                   @relation("ReportsMade")
  wishlistItems          WishlistItem[]
  trainerChangeRequests  TrainerChangeRequest[]
  aiChatConversations    AiChatConversation[]
  badges                 UserBadge[]
  referredBy             User?                      @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]                     @relation("Referrals")
  recommendedBundles     TrainerProductBundle[]
  challengeMessages      ChallengeMessage[]
  productScans           UserProductScan[]
}

// Chat history for the AI Assistant — each conversation belongs to exactly one
// user; messages are never readable cross-user (every query is userId-scoped).
model AiChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId])
}

model AiChatMessage {
  id                String   @id @default(cuid())
  conversationId    String
  role              String // "user" | "assistant"
  content           String   @db.Text
  suggestedMealJson String?  @db.Text
  createdAt         DateTime @default(now())

  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum TrainerChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// Audit trail of trainer-change asks — a user can never set gymTrainerId
// directly; approving+completing one of these is the only non-admin-initiated
// path to a trainer swap, and rows are never deleted (status-transitioned only).
model TrainerChangeRequest {
  id                    String                     @id @default(cuid())
  userId                String
  reason                String
  description           String?                    @db.Text
  preferredRequirements String?                    @db.Text
  status                TrainerChangeRequestStatus @default(PENDING)
  previousTrainerId     String?
  newTrainerId          String?
  adminComment          String?
  reviewedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model GymTrainer {
  id                   String                     @id @default(cuid())
  name                 String
  title                String?
  bio                  String?
  imageUrl             String?
  sortOrder            Int                        @default(0)
  certifications       String?
  specializations      String[]                   @default([])
  yearsExperience      Int?
  workingHours         String?
  languages            String[]                   @default([])
  contactEmail         String?
  contactPhone         String?
  active               Boolean                    @default(true)
  approved             Boolean                    @default(false)
  maxUsers             Int?
  linkedUserId         String?                    @unique
  linkedUser           User?                      @relation("TrainerLinkedAccount", fields: [linkedUserId], references: [id], onDelete: SetNull)
  assignedUsers        User[]                     @relation("AssignedTrainer")
  planRequests         WorkoutPlanChangeRequest[]
  mealPlanRequests     MealPlanChangeRequest[]
  missedWorkoutReports MissedWorkoutReport[]
  productBundles       TrainerProductBundle[]

  @@index([sortOrder])
}

model GymProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  imageUrl  String
  caption   String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MissedWorkoutReport {
  id           String   @id @default(cuid())
  userId       String
  gymTrainerId String
  reason       String   @db.Text
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gymTrainerId, createdAt])
}

model WorkoutPlanChangeRequest {
  id                   String           @id @default(cuid())
  userId               String
  gymTrainerId         String
  status               PlanChangeStatus @default(PENDING)
  memberNote           String?
  proposedSessionsJson String           @db.Text
  trainerComment       String?
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user       User       @relation("MemberPlanRequests", fields: [userId], references: [id], onDelete: Cascade)
  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("PlanReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymTrainerId, status])
}

model OtpChallenge {
  id           String     @id @default(cuid())
  email        String
  purpose      OtpPurpose
  codeHash     String
  name         String?
  passwordHash String?
  attempts     Int        @default(0)
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([email, purpose, expiresAt])
}

model Recipe {
  id          String         @id @default(cuid())
  name        String
  image       String
  category    RecipeCategory
  description String
  ingredients String[]
  steps       String[]
  calories    Int
  protein     Int
  carbs       Int
  fats        Int
  isCheatMeal Boolean        @default(false)
  createdAt   DateTime       @default(now())

  savedBy         SavedRecipe[]
  cheatSelections CheatMeal[]
}

model Tracker {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  weightKg         Float?
  caloriesConsumed Int?
  proteinIntake    Int?
  workoutCompleted Boolean  @default(false)
  hydrationMl      Int?
  sleepHours       Float?
  bodyFatPercent   Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model StrengthGoal {
  id             String   @id @default(cuid())
  userId         String
  exercise       String
  targetWeightKg Float
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exercise])
}

model Streak {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  // True when this day was covered by a streak freeze rather than a real
  // logged action — see shared/domain/streak.ts. Still counts as
  // `completed` for the consecutive-day walk, just distinguished for UI/copy.
  frozen    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// A user's earned achievements. Definitions (label/icon/criteria) live in
// code (shared/domain/badges.ts), not the database — this table only
// persists WHICH ones a user has actually earned and when, so re-checking
// doesn't need to re-derive history every time and "earnedAt" is meaningful
// for a celebration moment.
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeKey String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
}

model CheatMeal {
  id         String   @id @default(cuid())
  userId     String
  recipeId   String
  weekStart  DateTime
  selectedAt DateTime @default(now())
  expiresAt  DateTime
  consumed   Boolean  @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}

model Post {
  id                String   @id @default(cuid())
  userId            String
  content           String
  recipeLink        String?
  type              PostType @default(QUESTION)
  imageUrl          String?
  acceptedCommentId String?
  createdAt         DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     PostLike[]
  bookmarks PostBookmark[]
  reports   Report[]

  @@index([createdAt, id])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostBookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostDraft {
  id        String   @id @default(cuid())
  userId    String
  content   String
  type      PostType @default(QUESTION)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MealLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @default(now())
  slot     String
  name     String
  quantity String?
  status   String   @default("completed")
  calories Int      @default(0)
  protein  Float    @default(0)
  carbs    Float    @default(0)
  fat      Float    @default(0)
  fiber    Float    @default(0)
  waterMl  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model MealPlanChangeRequest {
  id               String           @id @default(cuid())
  userId           String
  gymTrainerId     String
  status           PlanChangeStatus @default(PENDING)
  requestType      String           @default("FULL_PLAN")
  reason           String?
  contextJson      String?          @db.Text
  wasModified      Boolean          @default(false)
  memberNote       String?
  proposedPlanJson String           @db.Text
  trainerComment   String?
  voiceNoteUrl     String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user       User       @relation("MemberMealRequests", fields: [userId], references: [id], onDelete: Cascade)
  gymTrainer GymTrainer @relation(fields: [gymTrainerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gymTrainerId, status])
}

model FavoriteMeal {
  id        String   @id @default(cuid())
  userId    String
  mealJson  String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User               @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User               @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ConversationRead[]

  @@unique([userAId, userBId])
  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ConversationRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
}

model Workout {
  id          String      @id @default(cuid())
  title       String
  description String
  type        WorkoutType
  goal        Goal
  durationMin Int
  level       String
  imageUrl    String?
  rating      Float?
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String
  performedAt DateTime @default(now())
  exercise    String
  sets        Int
  reps        Int
  weightKg    Float
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
}

enum WorkoutCompletionType {
  LOGGED
  DONE
}

// One row per user per calendar day — the source of truth for "has today's
// workout been completed" (persisted, so it survives refresh) and the thing
// that actually prevents completing the same day twice, via the unique
// constraint below. LOGGED means real WorkoutLog rows exist for the day;
// DONE means the user quick-completed without entering any details.
model WorkoutCompletion {
  id          String                @id @default(cuid())
  userId      String
  date        DateTime
  type        WorkoutCompletionType
  completedAt DateTime              @default(now())
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── E-Commerce ────────────────────────────────────────────────────────────────

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products Product[]

  @@index([slug])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Float
  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([code])
}

model Product {
  id           String        @id @default(cuid())
  categoryId   String
  name         String
  slug         String        @unique
  description  String        @db.Text
  price        Float
  comparePrice Float?
  imageUrls    String[]
  tags         String[]
  status       ProductStatus @default(DRAFT)
  stock        Int           @default(0)
  weight       Float?
  isVegan      Boolean       @default(true)
  isFeatured   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category     ProductCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  bundleItems  TrainerProductBundleItem[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([slug])
}

// A trainer-curated set of existing store products recommended to one
// specific assigned member, with a note explaining why — ties the real
// trainer relationship directly to commerce without any new payment or
// subscription infrastructure (this app has no recurring billing at all;
// checkout is one-time only). Reuses the exact trainer/member ownership
// pattern already established in workout-plan-requests.service.ts
// (GymTrainer.linkedUserId → trainer's own User account, member.gymTrainerId
// must match).
model TrainerProductBundle {
  id        String   @id @default(cuid())
  trainerId String
  memberId  String
  title     String
  note      String   @db.Text
  createdAt DateTime @default(now())

  trainer GymTrainer                 @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  member  User                       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items   TrainerProductBundleItem[]

  @@index([memberId])
  @@index([trainerId])
}

model TrainerProductBundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String

  bundle  TrainerProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  name           String
  line1          String
  line2          String?
  city           String
  state          String
  pincode        String
  country        String   @default("IN")
  email          String?
  phone          String?
  secondaryPhone String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  addressId       String?
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  stripePaymentId String?
  subtotal        Float
  tax             Float       @default(0)
  shipping        Float       @default(0)
  discount        Float       @default(0)
  couponCode      String?
  total           Float
  notes           String?     @db.Text
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([stripeSessionId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Float
  total       Float
  productSnap Json

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String?  @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, rating])
}

// ─── Notifications ──────────────────────────────────────────────────────────

enum NotificationType {
  ORDER_UPDATE
  COMMUNITY
  GYM
  MEAL
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ─── Community Reports ──────────────────────────────────────────────────────

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String
  reason     String
  status     ReportStatus @default(PENDING)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime     @default(now())

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([reporterId])
}

model JourneyProgress {
  id        String   @id @default(cuid())
  key       String   @unique
  step      Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum ChallengeCategory {
  MEAL
  WORKOUT
  STEPS
  WATER
  MEDITATION
  RECIPE
  GYM_PROGRESS
  CUSTOM
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Challenge {
  id            String              @id @default(cuid())
  title         String
  description   String              @db.Text
  category      ChallengeCategory   @default(CUSTOM)
  difficulty    ChallengeDifficulty @default(BEGINNER)
  coverImageUrl String?
  rules         String?             @db.Text
  rewardText    String?             @db.Text
  durationDays  Int
  startDate     DateTime            @default(now())
  endDate       DateTime
  createdById   String
  createdAt     DateTime            @default(now())

  createdBy    User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
  checkIns     ChallengeCheckIn[]
  messages     ChallengeMessage[]

  @@index([endDate])
}

model ChallengeParticipant {
  id               String   @id @default(cuid())
  challengeId      String
  userId           String
  joinedAt         DateTime @default(now())
  // One grace day per challenge join — a bounded, per-participation freeze
  // pool (separate from User.streakFreezesAvailable, which is the ongoing
  // main-streak allowance) since a challenge is itself bounded in duration;
  // one grace day is proportionally generous without needing to reconcile
  // against a shared cross-system pool.
  freezesAvailable Int      @default(1)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model ChallengeCheckIn {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  date        DateTime
  createdAt   DateTime @default(now())
  // True when this day was bridged by the participant's one grace-day
  // freeze rather than a real check-in — mirrors Streak.frozen.
  frozen      Boolean  @default(false)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, date])
}

// Club-style discussion scoped to one challenge's own participants — a
// different surface from the main community feed or 1:1 DMs, matching the
// market-research recommendation for dedicated per-challenge messaging.
model ChallengeMessage {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  text        String   @db.Text
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt])
}

// Shared, barcode-keyed cache of a product's vegan-compliance verdict —
// looked up once from Open Food Facts, reused by every user who scans the
// same barcode instead of re-fetching/re-analyzing every time. See
// shared/domain/veganScanner.ts for how verdict/citedIngredients get
// computed (real per-ingredient citations, not an opaque score).
model ScannedProductCache {
  barcode          String   @id
  productName      String?
  brand            String?
  imageUrl         String?
  ingredientsText  String?  @db.Text
  verdict          String
  citedIngredients Json
  verdictSource    String
  fetchedAt        DateTime @default(now())

  scans UserProductScan[]
}

model UserProductScan {
  id        String   @id @default(cuid())
  userId    String
  barcode   String
  scannedAt DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ScannedProductCache @relation(fields: [barcode], references: [barcode], onDelete: Cascade)

  @@index([userId, scannedAt])
}
